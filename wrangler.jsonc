// Cloudflare Workers 정적 자산: `npm run build` 가 만든 build/ 를 Worker 스크립트 없이 그대로 서빙합니다.
// .github/workflows/deploy.yml 이 main 푸시마다 테스트 · 빌드 뒤 `wrangler deploy` 를 실행합니다.
// `name` 은 대시보드의 Worker 이름이 됩니다. 바꾸면 새 Worker 가 생깁니다.
{
  "name": "portfolio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./build",
    // 한 페이지짜리 CRA 앱이라 없는 경로에도 index.html 을 돌려줍니다.
    "not_found_handling": "single-page-application"
  },
  // 배포할 때 루트 도메인을 Custom Domain 으로 붙입니다. DNS 레코드와 인증서는 Cloudflare 가 만듭니다.
  // 와일드카드(*.devgyurak.com)는 pykorail · mysql-gcm 서브도메인까지 가로채므로 쓰지 않습니다.
  "routes": [{ "pattern": "devgyurak.com", "custom_domain": true }],
  // 사이트는 devgyurak.com 에서만 열리게 합니다. *.workers.dev 주소는 끕니다.
  "workers_dev": false
}
